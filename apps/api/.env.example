API_CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEFAULT_TENANT_ID=22222222-2222-2222-2222-222222222222
WEB_BASE_URL=http://localhost:3000
# Email: mock (default, captures in-process) or ses
EMAIL_PROVIDER=mock
AWS_SES_REGION=
AWS_SES_FROM_EMAIL=
# Optional auth rate limit (per client IP): max requests per window
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_URL=postgresql+psycopg://worktrace:secret@localhost:5432/worktrace
# Optional K-means response cache; database fallback is used when unset/unavailable.
REDIS_URL=redis://localhost:6379/0
ANALYTICS_CACHE_TTL_SECONDS=3600
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=worktrace-screenshots
S3_REGION_NAME=us-east-1

SOP_GENERATOR=mock
# mock (default) uses deterministic vectors for embeddings; openai/anthropic hit real APIs
LLM_PROVIDER=mock
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=realkey
OPENAI_MODEL=gpt-4o
# Optional: route OpenAI SDK to OpenRouter (OpenAI-compatible API)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Or set OPENROUTER_API_KEY instead; base URL defaults to OpenRouter when only that key is set
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=WorkTrace
# OPENAI_MODEL=openai/gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
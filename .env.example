# Copy to .env before running Docker Compose.
POSTGRES_USER=worktrace
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=worktrace
SECRET_KEY=replace-with-at-least-32-random-characters
DEFAULT_TENANT_ID=22222222-2222-2222-2222-222222222222
# Local / assessor demo accounts only (seed_demo_roles.py). Not for production.
DEMO_ROLE_PASSWORD=11112222

API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=WorkTrace
# Build-time for the frontend image (baked into Next.js). After changing, rebuild:
#   docker compose up -d --build frontend
# Value = Chrome extension ID from chrome://extensions after loading apps/extension/dist
# (use a fixed manifest "key" so the ID stays stable across machines).
NEXT_PUBLIC_EXTENSION_ID=bajibpeckacmfdmifdhccckiepadhgog

SOP_GENERATOR=mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PRELOAD_WHISPER_MODEL=false

# Local MinIO (see DEPLOYMENT_GUIDE.md). Start MinIO before compose, then:
#   docker compose up -d --force-recreate api worker
S3_ENDPOINT_URL=http://host.docker.internal:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=worktrace-screenshots
S3_REGION_NAME=us-east-1
